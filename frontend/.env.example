# --- AkaRouter Frontend env ---
# Copy to .env.local and fill in real values. Next.js loads .env.local
# automatically in dev. In production, set these in Railway / Vercel / etc.

# Backend API base (server-side only; on the client we use /api/* rewrites).
NEXT_PUBLIC_API_URL=https://akarouter-production.up.railway.app

# The publicly-reachable URL of THIS frontend (no trailing slash).
# Used by server-side route handlers (e.g. /auth/callback) to build
# redirect URLs that work behind proxies, Docker networks, and reverse
# proxies. When unset, we fall back to the request's Host header, which
# is what arrives at the route handler from the reverse proxy.
# Set this to your public frontend URL in production to avoid issues
# where the Origin of an incoming request is a Docker container hostname
# instead of the real public domain.
NEXT_PUBLIC_SITE_URL=https://akarouter.dev

# Supabase project.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Google reCAPTCHA v3 site key (browser-safe public key).
# Get it from https://www.google.com/recaptcha/admin
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your-recaptcha-site-key-here
