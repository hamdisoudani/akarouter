# AkaRouter Frontend — environment variables
#
# How to use this file:
#   1. Copy to `.env.local` for local development
#   2. Fill in real values
#   3. In production (Railway / Vercel / etc.) set these in the platform
#
# SECURITY: every var with the `NEXT_PUBLIC_` prefix is INLINED INTO THE
# JAVASCRIPT BUNDLE at build time. Anything you put here is publicly
# visible to anyone who views the page source. NEVER put a real secret
# (API key, password, JWT signing key) in a NEXT_PUBLIC_* var.
#
# If a var isn't here, the build will fail with a clear zod validation
# error pointing at the missing key (see lib/env.ts). That's the safe
# default — better to fail loud at build time than to ship a broken
# bundle.


# ============================================================================
# Backend API
# ============================================================================

# Base URL of the AkaRouter backend (server-side only — the client
# uses /api/* rewrites via proxy.ts instead of calling this directly).
# Trailing slash is optional.
NEXT_PUBLIC_API_URL=https://akarouter-production.up.railway.app


# ============================================================================
# Public site URL
# ============================================================================

# The publicly-reachable URL of THIS frontend (no trailing slash).
# Used by server-side route handlers (e.g., /auth/callback) to build
# redirect URLs that work behind proxies, Docker networks, and reverse
# proxies.
#
# WHY THIS MATTERS: when the app is behind a reverse proxy (Railway,
# Cloudflare, ngrok) the `Host` header seen by the server can be the
# Docker container hostname (e.g., `830635b86b84:8080`) rather than the
# real public domain. If we built the post-login redirect URL from
# `request.headers.get("host")` without normalization, the user would
# land on a broken URL. Set this to the real public URL to avoid that.
NEXT_PUBLIC_SITE_URL=https://akarouter.dev


# ============================================================================
# Supabase
# ============================================================================

# Supabase project URL (e.g., https://abcxyz.supabase.co). The anon
# key below is safe to ship to the browser; RLS in Supabase enforces
# per-user access regardless.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# Supabase anon key. SAFE TO SHIP TO THE BROWSER — it only works for
# users who have a valid session JWT, and RLS prevents cross-user
# reads. Get it from: Supabase dashboard → Settings → API → anon key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here


# ============================================================================
# Google reCAPTCHA v3
# ============================================================================

# reCAPTCHA v3 site key. Browser-safe; the corresponding secret key
# lives in the backend (AKAROUTER_RECAPTCHA_SECRET — NOT in this file).
# Get it from: https://www.google.com/recaptcha/admin
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your-recaptcha-site-key-here


# ============================================================================
# Admin bypass (DEPRECATED — remove in PR 22)
# ============================================================================
#
# ⚠️  SECURITY WARNING ⚠️
#
# NEXT_PUBLIC_ADMIN_KEY is a CLIENT-SIDE admin bypass. If set, the
# /admin page will treat the value as a valid admin token and let the
# user act as admin WITHOUT going through Supabase auth.
#
# Because this is a NEXT_PUBLIC_* var, the value is BAKED INTO THE
# JAVASCRIPT BUNDLE. Any visitor can extract it from the page source
# and use it to become admin. The backend rejects it in production
# (only honored when AKAROUTER_APP_ENV == "development"), so a leak
# in production would not grant admin access — but it would be visible
# to the world.
#
# RECOMMENDED: leave this empty. Admin auth should come from a real
# Supabase user with `role = 'admin'`. The bypass in
# app/admin/page.tsx (lines ~277-285) should be removed in PR 22.
#
# If you must use it for local development, set a long random string
# here AND set the same value as AKAROUTER_ADMIN_DEV_TOKEN in the
# backend's .env (with AKAROUTER_APP_ENV=development on the backend).
# NEVER set this in production.
NEXT_PUBLIC_ADMIN_KEY=


# ============================================================================
# Backwards-compat / deprecated
# ============================================================================
#
# These vars appeared in older versions of the frontend or backend and
# are kept here as documentation for operators upgrading. None of them
# are read by the current code.
#
# AKAROUTER_AKAROUTER_DEFAULT_MODEL — renamed; the model mapping is
#   now in app/core/config.py: model_mapping.
# AKAROUTER_AKAROUTER_DEFAULT_PRO_MODEL — same.
