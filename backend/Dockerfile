FROM python:3.12-slim
WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY . .
# Ensure runtime env vars are available in the container
# SECURITY: every var the app reads at startup or first request must be
# declared here AND exported as ENV. A var that's only ARG'd is set during
# the build stage but lost at runtime — the container would start with
# undefined settings and either crash or silently fall back to defaults.
ARG AKAROUTER_APP_ENV
ARG AKAROUTER_SUPABASE_URL
ARG AKAROUTER_SUPABASE_SERVICE_ROLE_KEY
ARG AKAROUTER_SUPABASE_DB_URL
ARG AKAROUTER_NOUS_API_BASE
ARG AKAROUTER_NOUS_CLIENT_ID
ARG AKAROUTER_NOUS_SCOPE
ARG AKAROUTER_NOUS_DEVICE_CODE_URL
ARG AKAROUTER_NOUS_TOKEN_URL
ARG AKAROUTER_TOKEN_REFRESH_SKEW
ARG AKAROUTER_REFRESH_LOCK_TTL
ARG AKAROUTER_MAX_CONCURRENT_PER_ACCOUNT
ARG AKAROUTER_WHOP_API_KEY
ARG AKAROUTER_WHOP_WEBHOOK_SECRET
ARG AKAROUTER_WHOP_COMPANY_ID
ARG AKAROUTER_WHOP_PLAN_STARTER
ARG AKAROUTER_WHOP_PLAN_PRO
ARG AKAROUTER_WHOP_PLAN_ULTRA
# Fernet key for at-rest encryption of hosted agent API keys
ARG AKAROUTER_AGENT_KEY_ENCRYPTION_SECRET
# Lock backend selection: postgres | memory
ARG AKAROUTER_LOCK_BACKEND
# CORS allowlist (comma-separated or JSON list)
ARG AKAROUTER_CORS_ORIGINS
# Daytona sandbox integration (used by hosted_agents endpoints)
ARG AKAROUTER_DAYTONA_API_BASE
ARG AKAROUTER_DAYTONA_API_KEY
ARG AKAROUTER_DAYTONA_SANDBOX_CPU
ARG AKAROUTER_DAYTONA_SANDBOX_MEMORY
ARG AKAROUTER_DAYTONA_SANDBOX_DISK
ARG AKAROUTER_PUBLIC_BACKEND_URL
# Dev-only admin token (must remain empty in production)
ARG AKAROUTER_ADMIN_DEV_TOKEN

# Export all as runtime env vars
ENV AKAROUTER_APP_ENV=${AKAROUTER_APP_ENV:-production}
ENV AKAROUTER_SUPABASE_URL=$AKAROUTER_SUPABASE_URL
ENV AKAROUTER_SUPABASE_SERVICE_ROLE_KEY=$AKAROUTER_SUPABASE_SERVICE_ROLE_KEY
ENV AKAROUTER_SUPABASE_DB_URL=$AKAROUTER_SUPABASE_DB_URL
ENV AKAROUTER_NOUS_API_BASE=$AKAROUTER_NOUS_API_BASE
ENV AKAROUTER_NOUS_CLIENT_ID=$AKAROUTER_NOUS_CLIENT_ID
ENV AKAROUTER_NOUS_SCOPE=$AKAROUTER_NOUS_SCOPE
ENV AKAROUTER_NOUS_DEVICE_CODE_URL=$AKAROUTER_NOUS_DEVICE_CODE_URL
ENV AKAROUTER_NOUS_TOKEN_URL=$AKAROUTER_NOUS_TOKEN_URL
ENV AKAROUTER_TOKEN_REFRESH_SKEW=$AKAROUTER_TOKEN_REFRESH_SKEW
ENV AKAROUTER_REFRESH_LOCK_TTL=$AKAROUTER_REFRESH_LOCK_TTL
ENV AKAROUTER_MAX_CONCURRENT_PER_ACCOUNT=$AKAROUTER_MAX_CONCURRENT_PER_ACCOUNT
ENV AKAROUTER_WHOP_API_KEY=$AKAROUTER_WHOP_API_KEY
ENV AKAROUTER_WHOP_WEBHOOK_SECRET=$AKAROUTER_WHOP_WEBHOOK_SECRET
ENV AKAROUTER_WHOP_COMPANY_ID=$AKAROUTER_WHOP_COMPANY_ID
ENV AKAROUTER_WHOP_PLAN_STARTER=$AKAROUTER_WHOP_PLAN_STARTER
ENV AKAROUTER_WHOP_PLAN_PRO=$AKAROUTER_WHOP_PLAN_PRO
ENV AKAROUTER_WHOP_PLAN_ULTRA=$AKAROUTER_WHOP_PLAN_ULTRA
ENV AKAROUTER_AGENT_KEY_ENCRYPTION_SECRET=$AKAROUTER_AGENT_KEY_ENCRYPTION_SECRET
ENV AKAROUTER_LOCK_BACKEND=$AKAROUTER_LOCK_BACKEND
ENV AKAROUTER_CORS_ORIGINS=$AKAROUTER_CORS_ORIGINS
ENV AKAROUTER_DAYTONA_API_BASE=$AKAROUTER_DAYTONA_API_BASE
ENV AKAROUTER_DAYTONA_API_KEY=$AKAROUTER_DAYTONA_API_KEY
ENV AKAROUTER_DAYTONA_SANDBOX_CPU=$AKAROUTER_DAYTONA_SANDBOX_CPU
ENV AKAROUTER_DAYTONA_SANDBOX_MEMORY=$AKAROUTER_DAYTONA_SANDBOX_MEMORY
ENV AKAROUTER_DAYTONA_SANDBOX_DISK=$AKAROUTER_DAYTONA_SANDBOX_DISK
ENV AKAROUTER_PUBLIC_BACKEND_URL=$AKAROUTER_PUBLIC_BACKEND_URL
ENV AKAROUTER_ADMIN_DEV_TOKEN=$AKAROUTER_ADMIN_DEV_TOKEN

ENV PORT=8000
EXPOSE 8000
CMD uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8000}
