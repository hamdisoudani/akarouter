# AkaRouter Backend — environment variables
#
# How to use this file:
#   1. Copy to `.env` for local development
#   2. Fill in real values for the dev environment
#   3. In production (Railway / Render / etc.) set these via the platform's
#      secret manager — DO NOT commit a real `.env` to git
#   4. See `docs/deploy.md` (or Railway dashboard) for production setup
#
# SECURITY: every var below is read by `app/core/config.py`. The schema is
# the single source of truth — if you add a new env var, add it here AND
# in `app/core/config.py` AND (if it's a build-time var for the frontend)
# in `frontend/.env.example`.
#
# SECURITY: secrets are NEVER baked into the Docker image (see the
# Dockerfile's ENV exports — only non-secret defaults are exported).
# The image assumes Railway (or your platform) injects secrets at
# runtime as container env vars. This way `docker history` and any
# registry the image is pushed to never see the secret values.


# ============================================================================
# App
# ============================================================================

# App environment. Valid values: "production", "staging", "development".
# SECURITY: defaults to "production" if unset so a missing var fails
# CLOSED. Setting this to "development" re-enables dev-only backdoors
# (e.g., the admin_dev_token check in app/api/admin/routes.py). Never
# set this to "development" in any deployed environment.
AKAROUTER_APP_ENV=production

# Port the FastAPI app listens on. Railway sets $PORT automatically;
# we read AKAROUTER_PORT as a fallback.
AKAROUTER_PORT=8000

# Dev-only admin token. Used to authenticate against /admin/* endpoints
# when AKAROUTER_APP_ENV == "development".
#
# SECURITY: leave EMPTY in production. Generate a high-entropy token with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# The check is:
#   - Only honored when app_env == "development"
#   - Constant-time comparison (hmac.compare_digest) to prevent timing
#     attacks
#   - Completely independent of any database / Supabase credential
#
# DO NOT reuse the Supabase service-role key here. DO NOT set this in
# Railway / Render / etc. for any non-dev environment.
AKAROUTER_ADMIN_DEV_TOKEN=


# ============================================================================
# Supabase (REQUIRED)
# ============================================================================
#
# All three vars must be set for the backend to function. The app refuses
# to start if any is empty (see app/core/supabase.py: get_supabase()).

# Your Supabase project URL (e.g., https://abcxyz.supabase.co)
AKAROUTER_SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# Supabase service-role key (NOT the anon key). The service-role key has
# god-mode access to the project — it bypasses RLS and can read/write any
# table. Treat it like a database password.
# Get it from: Supabase dashboard → Settings → API → service_role key
AKAROUTER_SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Direct Postgres connection string to the Supabase database. Used by
# the advisory-lock backend (app/core/locks.py) for distributed locks.
# Format: postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres
#
# Use the DIRECT connection (port 5432) not the pooler (port 6543) — the
# advisory lock functions use transaction-scoped locks that don't play
# well with the pooler's transaction mode.
#
# ROTATE this password after any incident where the value leaks (e.g.,
# it appearing in a commit, log file, or screenshot).
AKAROUTER_SUPABASE_DB_URL=postgresql://postgres:YOUR_DB_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres


# ============================================================================
# Nous / Hermes OAuth
# ============================================================================
# These are the upstream endpoints and OAuth config for the Hermes
# Inference API. Defaults are correct for production; override only for
# local dev or a fork.

AKAROUTER_NOUS_API_BASE=https://inference-api.nousresearch.com/v1
AKAROUTER_NOUS_CLIENT_ID=hermes-cli
AKAROUTER_NOUS_SCOPE=inference:invoke
AKAROUTER_NOUS_DEVICE_CODE_URL=https://portal.nousresearch.com/api/oauth/device/code
AKAROUTER_NOUS_TOKEN_URL=https://portal.nousresearch.com/api/oauth/token

# How many seconds BEFORE token expiry to trigger a refresh. 120 = 2 min.
AKAROUTER_TOKEN_REFRESH_SKEW=120

# How long a refresh lock is valid before another worker may steal it.
# 30s is enough to ride out transient failures without holding the lock
# indefinitely if the worker crashes mid-refresh.
AKAROUTER_REFRESH_LOCK_TTL=30

# Max in-flight requests per upstream account. 12 keeps us well under
# typical per-account rate limits.
AKAROUTER_MAX_CONCURRENT_PER_ACCOUNT=12


# ============================================================================
# Lock backend
# ============================================================================
# Which lock backend to use for distributed locks (webhook dedup, tier
# upgrade, account budget).
#
# Values:
#   "postgres" — uses Supabase advisory locks. Default. Recommended for
#                production: battle-tested, no extra infra, auto-released
#                on transaction end.
#   "memory"   — in-process asyncio locks. Only correct for a single-
#                worker deployment (which is the current setup, but
#                don't grow into it).
#
# See app/core/locks.py for the LockBackend Protocol.
AKAROUTER_LOCK_BACKEND=postgres


# ============================================================================
# Encryption
# ============================================================================

# Fernet key for at-rest encryption of hosted agent API keys (see
# app/core/router.py: encrypt_agent_key / decrypt_agent_key).
# REQUIRED — the app fails to start if this is empty.
#
# Generate a new one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# Rotate carefully: changing this key invalidates all stored encrypted
# agent keys. Plan a migration if you rotate.
AKAROUTER_AGENT_KEY_ENCRYPTION_SECRET=


# ============================================================================
# Whop (subscription billing)
# ============================================================================
# Whop handles checkout + webhooks. We use the API to resolve product
# IDs and the webhook to receive subscription events.

# Whop API key (Bearer token). Get it from:
#   Whop dashboard → Settings → API → API keys
AKAROUTER_WHOP_API_KEY=

# Shared secret used to verify Whop webhook signatures (HMAC-SHA256).
# Get it from: Whop dashboard → Settings → Webhooks → Signing secret
# The webhook endpoint /v1/webhooks/whop refuses any request whose
# signature doesn't match.
AKAROUTER_WHOP_WEBHOOK_SECRET=

# Whop company ID. Used to filter products in /v1/plans.
AKAROUTER_WHOP_COMPANY_ID=

# Whop plan IDs for the three paid tiers. Get them from your Whop
# dashboard after creating the plans. The free tier doesn't need a
# Whop plan.
AKAROUTER_WHOP_PLAN_STARTER=
AKAROUTER_WHOP_PLAN_PRO=
AKAROUTER_WHOP_PLAN_ULTRA=


# ============================================================================
# CORS
# ============================================================================
# Comma-separated list of origins allowed to call the API from the
# browser, OR a JSON array. No trailing slashes.
#
# Production should list ONLY the real public frontend origins:
#   https://akarouter.dev
#   https://akarouter-frontend-production.up.railway.app
#
# DO NOT include http://localhost:3000 in production. The dev fallback
# in app/core/config.py is for local development ONLY.
AKAROUTER_CORS_ORIGINS=https://akarouter.dev,https://akarouter-frontend-production.up.railway.app


# ============================================================================
# Daytona (sandboxed hosted agents)
# ============================================================================
# Daytona creates disposable Linux sandboxes that run user-submitted
# agent code. We use the Daytona API to spin up / down sandboxes.

# Daytona API base (no trailing slash)
AKAROUTER_DAYTONA_API_BASE=https://app.daytona.io/api

# Daytona API key (dtn_...)
AKAROUTER_DAYTONA_API_KEY=

# Per-sandbox resource limits. These are billed against your Daytona
# quota, so set them to the smallest values that still work for your
# agent's typical workload. Defaults are conservative (1 CPU, 1 GB RAM,
# 3 GB disk).
AKAROUTER_DAYTONA_SANDBOX_CPU=1
AKAROUTER_DAYTONA_SANDBOX_MEMORY=1
AKAROUTER_DAYTONA_SANDBOX_DISK=3

# Public base URL the Daytona sandbox can use to reach THIS backend.
# Required because the sandbox runs in a private network and can't
# resolve "localhost". Set this to the public URL of your deployed
# backend (e.g., https://akarouter-production.up.railway.app).
AKAROUTER_PUBLIC_BACKEND_URL=


# ============================================================================
# Agent limits (per tier)
# ============================================================================
# Max number of hosted-agent sandboxes an account can have at once.
# Used by app/api/hosted_agents.py to enforce the cap before spinning
# up a new sandbox.

AKAROUTER_MAX_AGENTS_FREE=1
AKAROUTER_MAX_AGENTS_PRO=3
AKAROUTER_MAX_AGENTS_ENTERPRISE=10
