AKAROUTER_APP_ENV=development
AKAROUTER_PORT=8000
AKAROUTER_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
AKAROUTER_SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
AKAROUTER_SUPABASE_DB_URL=postgresql://postgres:YOUR_DB_PASSWORD@YOUR_DB_HOST:5432/postgres
AKAROUTER_NOUS_API_BASE=https://inference-api.nousresearch.com/v1
AKAROUTER_NOUS_CLIENT_ID=hermes-cli
AKAROUTER_NOUS_SCOPE=inference:invoke
AKAROUTER_TOKEN_REFRESH_SKEW=120
AKAROUTER_REFRESH_LOCK_TTL=30
AKAROUTER_MAX_CONCURRENT_PER_ACCOUNT=12
AKAROUTER_AKAROUTER_DEFAULT_MODEL=stepfun/step-3.7-flash:free
AKAROUTER_AKAROUTER_DEFAULT_PRO_MODEL=stepfun/step-3.7-flash:free
# CORS Origins (comma-separated or JSON list)
AKAROUTER_CORS_ORIGINS=http://localhost:3000,https://akarouter.dev
