{
  "name": "OpenClaw Workspace",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-22-bookworm",
  "features": {},
  "forwardPorts": [8000, 8080],
  "containerEnv": {
    "AKAROUTER_URL": "${localEnv:AKAROUTER_URL:https://api.akarouter.com/v1}",
    "AKAROUTER_API_KEY": "${localEnv:AKAROUTER_API_KEY}",
    "MODEL_NAME": "${localEnv:MODEL_NAME:akarouter-pro}",
    
    "TELEGRAM_ENABLED": "${localEnv:TELEGRAM_ENABLED:false}",
    "TELEGRAM_BOT_TOKEN": "${localEnv:TELEGRAM_BOT_TOKEN}",
    "TELEGRAM_DM_POLICY": "${localEnv:TELEGRAM_DM_POLICY:allowlist}",
    "TELEGRAM_ALLOW_FROM": "${localEnv:TELEGRAM_ALLOW_FROM}",

    "DISCORD_ENABLED": "${localEnv:DISCORD_ENABLED:false}",
    "DISCORD_BOT_TOKEN": "${localEnv:DISCORD_BOT_TOKEN}",
    "DISCORD_GROUP_POLICY": "${localEnv:DISCORD_GROUP_POLICY:allowlist}",
    "DISCORD_GUILDS": "${localEnv:DISCORD_GUILDS}"
  },
  "postCreateCommand": "bash .devcontainer/setup.sh"
}
